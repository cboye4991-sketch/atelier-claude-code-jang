# Copy to .env (git-ignored) and fill in locally. Keep every value empty here.
#
# WARNING: anything prefixed with VITE_ is bundled into the client code and
# visible to everyone. NEVER put a secret (Dify key, Gemini key, service account)
# in a VITE_ variable.

# Public URL of the relay that proxies the correction workflow (not a secret).
VITE_RELAIS_URL=

# The Dify API key is NOT configured here: it lives only in the relay
# (dify-relay), as a Cloudflare secret (`npx wrangler secret put DIFY_API_KEY`).
